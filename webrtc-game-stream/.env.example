# WebRTC Game Streaming - Environment Variables Example
# Copy this file to .env and customize as needed

# ============================================
# CAPTURE MODE CONFIGURATION
# ============================================

# Capture mode: "container" or "host"
# - container: Run games inside Docker (default)
# - host: Stream games running on your host machine
CAPTURE_MODE=container

# X11 Display to capture
# - For container mode: :1 (virtual display)
# - For host mode: :0 (your actual display)
# DISPLAY=:0

# ============================================
# GAME SELECTION (Container Mode)
# ============================================

# Specify which game to run from the games/ folder
# Leave empty to run the first game found
# Examples: GAME_NAME=my-game.sh or GAME_NAME=game2.sh
GAME_NAME=

# ============================================
# SIGNALING SERVER
# ============================================

# WebSocket URL for signaling server
SIGNALING_URL=ws://localhost:9000

# Room name for WebRTC session
ROOM=room1

# ============================================
# EXAMPLES
# ============================================

# Example 1: Container mode with specific game
# CAPTURE_MODE=container
# GAME_NAME=my-game.sh

# Example 2: Host mode (stream existing games)
# CAPTURE_MODE=host
# DISPLAY=:0

# Example 3: Host mode with custom display
# CAPTURE_MODE=host
# DISPLAY=:1
